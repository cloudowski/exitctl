# version layout and json (US9).
exec exitctl version
stdout '^exitctl +\S+$'
stdout '^catalog +[0-9]{4}\.[0-9]{2}\.[0-9]+ \(schema [0-9]+\.[0-9]+\)$'
stdout '^rules +[0-9]+\.[0-9]+\.[0-9]+$'
stdout '^result format +exitctl\.result/v1$'

exec exitctl version --format json
stdout '"result_format": "exitctl.result/v1"'
stdout '"catalog_schema": "'

exec exitctl scan $FIXTURES/shop-aws --include-drafts --as-of 2026-10-06 --repo-name shop-aws --format json --no-store
stdout '"rules": "'

! exec exitctl version --format yaml
stderr 'unknown --format'
