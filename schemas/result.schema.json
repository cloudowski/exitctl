{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exitctl:schema:result:v1",
  "title": "exitctl result document",
  "description": "Result of scan, merge, or graph export. Arrays are sorted by documented keys; no timestamps; paths are repo-relative with '/'.",
  "type": "object",
  "required": [
    "format",
    "kind",
    "versions",
    "inputs",
    "facts",
    "graph",
    "analysis"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "exitctl.result/v1"
    },
    "kind": {
      "enum": [
        "result",
        "graph"
      ]
    },
    "versions": {
      "$ref": "#/$defs/versions"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted by repo. One entry per scanned repository or merged input.",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "as_of",
          "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string"
          },
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "versions": {
            "$ref": "#/$defs/versions"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "required": [
        "sources",
        "raw_nodes",
        "raw_edges",
        "package_uses",
        "code_uses",
        "gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "raw_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rawNode"
          }
        },
        "raw_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rawEdge"
          }
        },
        "package_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageUse"
          }
        },
        "code_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeUse"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "groups",
        "sccs"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "sccs": {
          "type": "array",
          "description": "Cycle groups with more than one member ('must move together').",
          "items": {
            "type": "object",
            "required": [
              "id",
              "members"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              }
            }
          }
        }
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    }
  },
  "$defs": {
    "versions": {
      "type": "object",
      "required": [
        "tool",
        "catalog",
        "catalog_schema",
        "rules",
        "config_fingerprint",
        "custom_scoring"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "catalog": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
        },
        "catalog_schema": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "rules": {
          "type": "string"
        },
        "config_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "custom_scoring": {
          "type": "boolean"
        },
        "catalog_drafts_included": {
          "type": "boolean",
          "description": "True when draft catalog entries were scored (hidden --include-drafts, development only)."
        }
      }
    },
    "level": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "dimension": {
      "enum": [
        "technical",
        "data",
        "operational",
        "economic",
        "skills"
      ]
    },
    "sourceKind": {
      "enum": [
        "terraform",
        "cloudformation",
        "cdk",
        "pulumi",
        "kubernetes",
        "helm",
        "kustomize",
        "dockerfile",
        "github-actions",
        "gitlab-ci",
        "package-manifest",
        "sbom",
        "code"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "excerpt",
        "source_kind"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "maxLength": 120
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "path",
        "kind",
        "status"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "status": {
          "enum": [
            "parsed",
            "partial",
            "skipped",
            "failed",
            "unresolved"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "rawNode": {
      "type": "object",
      "required": [
        "id",
        "node_kind",
        "source_kind",
        "type",
        "native_address",
        "attributes",
        "multiplicity",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "node_kind": {
          "enum": [
            "resource",
            "component"
          ]
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "type": {
          "type": "string"
        },
        "native_address": {
          "type": "string"
        },
        "provider_identity": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "description": "Literal values; {\"$unknown\":true} for non-literals; {\"$redacted\":true} for secrets."
        },
        "multiplicity": {
          "enum": [
            "one",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "rawEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "evidence"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "attribute": {
          "type": "string"
        },
        "kind_hint": {
          "enum": [
            "ordering"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "packageUse": {
      "type": "object",
      "required": [
        "component",
        "ecosystem",
        "name",
        "manifest"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "pypi",
            "go",
            "maven",
            "nuget",
            "rubygems",
            "composer",
            "cargo"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "codeUse": {
      "type": "object",
      "required": [
        "component",
        "ecosystem",
        "pattern_kind",
        "service",
        "evidence"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "pypi",
            "go",
            "maven",
            "nuget",
            "rubygems",
            "composer",
            "cargo"
          ]
        },
        "pattern_kind": {
          "enum": [
            "import",
            "usage",
            "sdk-name"
          ]
        },
        "service": {
          "type": "string",
          "description": "Service ID resolved at scan time; re-resolved on merge when the catalog changes."
        },
        "match": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "kind",
        "subject",
        "count"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unknown_type",
            "unknown_sdk",
            "unresolved_module",
            "unresolved_chart",
            "unresolved_reference",
            "parse_failure",
            "remote_kustomize"
          ]
        },
        "subject": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "type": "string",
          "description": "unknown_sdk only: cloud provider derived from the SDK package or client name."
        },
        "service": {
          "type": "string",
          "description": "unknown_sdk only: service name derived from the SDK package or client name."
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "trait",
        "level",
        "dimensions",
        "origin",
        "evidence",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "trait": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        },
        "origin": {
          "type": "string",
          "pattern": "^(service|sdk|binding|rule:.+)$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "status": {
          "enum": [
            "active",
            "accepted"
          ]
        },
        "exception": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "type",
        "class",
        "sources",
        "findings",
        "risk",
        "weight",
        "dependents_count",
        "wave"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "enum": [
            "resource",
            "component",
            "implied_service"
          ]
        },
        "type": {
          "type": "string"
        },
        "native_address": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "class": {
          "enum": [
            "service",
            "neutral",
            "unknown",
            "unverified",
            "context",
            "component"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rounded to 4 decimals."
        },
        "weight": {
          "type": "number",
          "minimum": 1
        },
        "dependents_count": {
          "type": "integer",
          "minimum": 0
        },
        "dependents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sorted IDs; used by the HTML blast-radius highlight."
        },
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "scc": {
          "type": "integer"
        },
        "group": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "kind",
        "confidence",
        "evidence"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "The dependent."
        },
        "to": {
          "type": "string",
          "description": "The dependency."
        },
        "kind": {
          "enum": [
            "reference",
            "ordering",
            "binding",
            "data-flow",
            "usage",
            "containment"
          ]
        },
        "confidence": {
          "enum": [
            "exact",
            "resource-level",
            "service-level"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "type",
            "module",
            "namespace",
            "component"
          ]
        },
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent": {
          "type": "string"
        },
        "max_risk": {
          "type": "number"
        },
        "contribution": {
          "type": "number"
        }
      }
    },
    "alternativeView": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "difficulty",
        "compatibility",
        "recommended"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "oss-self-hosted",
            "managed-oss",
            "european-provider",
            "other-provider"
          ]
        },
        "difficulty": {
          "enum": [
            "low",
            "medium",
            "high",
            "very-high"
          ]
        },
        "compatibility": {
          "enum": [
            "api-compatible",
            "protocol-compatible",
            "conceptual"
          ]
        },
        "recommended": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "status",
        "coverage",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "nothing_to_scan",
            "nothing_scored"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "index_without_exceptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "range": {
          "type": "object",
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "integer"
            },
            "upper": {
              "type": "integer"
            }
          }
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "confidence": {
          "enum": [
            "normal",
            "provisional",
            "withheld"
          ]
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "technical": {
              "type": [
                "integer",
                "null"
              ]
            },
            "data": {
              "type": [
                "integer",
                "null"
              ]
            },
            "operational": {
              "type": [
                "integer",
                "null"
              ]
            },
            "skills": {
              "type": [
                "integer",
                "null"
              ]
            },
            "economic": {
              "type": "null",
              "description": "Not assessed in the open source core."
            }
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rank",
              "node",
              "contribution",
              "dependents_count",
              "alternatives"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "node": {
                "type": "string"
              },
              "contribution": {
                "type": "number"
              },
              "dependents_count": {
                "type": "integer"
              },
              "components_using": {
                "type": "integer"
              },
              "sdk_files": {
                "type": "integer"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/alternativeView"
                }
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "lever": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "service": {
              "type": "string"
            },
            "alternative": {
              "type": "string"
            },
            "delta": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "types",
            "resources",
            "weighted",
            "unknown_types"
          ],
          "properties": {
            "types": {
              "type": "number"
            },
            "resources": {
              "type": "number"
            },
            "weighted": {
              "type": "number"
            },
            "unknown_types": {
              "type": "integer"
            },
            "unverified_matches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "wave",
              "units"
            ],
            "properties": {
              "wave": {
                "type": "integer"
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nodes"
            ],
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "state",
              "reason",
              "owner",
              "matched_findings"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "active",
                  "expired",
                  "invalid"
                ]
              },
              "reason": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "expires": {
                "type": "string",
                "format": "date"
              },
              "matched_findings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
